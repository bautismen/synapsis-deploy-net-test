<?xml version="1.0" encoding="utf-8"?>
<!--
  Este perfil NO trae credenciales ni la URL del servidor:
  todo eso se pasa como parámetros /p:... desde el workflow de GitHub Actions,
  para no commitear secretos en el repo.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <EnableMSDeployBackup>true</EnableMSDeployBackup>
    <UserName>$(DeployUserName)</UserName>
    <MSDeployServiceURL>$(DeployServerUrl)</MSDeployServiceURL>
    <DeployIisAppPath>$(DeployIisAppPath)</DeployIisAppPath>
    <SkipExtraFilesOnServer>false</SkipExtraFilesOnServer>
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
  </PropertyGroup>
</Project>
